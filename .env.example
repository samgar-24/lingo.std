# WhatsApp менеджера: только цифры, с кодом страны, без "+"
NEXT_PUBLIC_WHATSAPP_NUMBER=77001234567
# (опционально) URL вебхука для лидов: Supabase Edge Function, Zapier, n8n, Telegram-бот и т.д.
LEAD_WEBHOOK_URL=
# (опционально) уведомление менеджеру в Telegram о каждом новом лиде
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Supabase (хранение лидов). Ключ — service_role / secret, только на сервере, НЕ NEXT_PUBLIC
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Ссылка в «Поделиться результатом» (по умолчанию — адрес сайта)
NEXT_PUBLIC_SHARE_URL=
